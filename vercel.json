{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd smartshop-frontend && npm run build",
  "outputDirectory": "smartshop-frontend/dist",
  "installCommand": "npm install --legacy-peer-deps && cd smartshop-frontend && npm install --legacy-peer-deps",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
