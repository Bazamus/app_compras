{
  "builds": [
    {
      "src": "smartshop-frontend/package.json",
      "use": "@vercel/vite",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/dist/index.js" }
  ]
}
